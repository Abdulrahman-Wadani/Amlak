{
	"name": "amlak",
	"private": true,
	"workspaces": [
		"apps/api",
		"apps/web",
		"packages/*"
	],
	"scripts": {
		"typecheck": "bun run --filter \"*\" typecheck",
		"test": "bun run --filter @amlak/shared test && bun run --filter api test && bun run --filter web test:run",
		"check": "biome check",
		"fix": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15"
	}
}
