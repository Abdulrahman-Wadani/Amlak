# Read by compose.yaml (development) and compose.prod.yaml (the server).

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Create one at resend.com/api-keys. Without it, emails are printed in the API logs
RESEND_API_KEY=""

# Sender address on the verified domain; without it, Resend's test sender is used
EMAIL_FROM="Amlak <noreply@mail.amlak.software>"

# Where the web app runs; invitation links in emails point here (development only;
# compose.prod.yaml uses https://DOMAIN)
# APP_URL="http://localhost:5173"

# Photo storage on AWS S3. Use the bucket's full name as S3 shows it
S3_BUCKET=""
S3_REGION="eu-central-1"
# Keys of the amlak-dev IAM user, for development only. The server uses its IAM role
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# The server only (compose.prod.yaml)
# The site's domain, without https://. Its DNS A record must point to the server
DOMAIN="amlak.software"
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=""