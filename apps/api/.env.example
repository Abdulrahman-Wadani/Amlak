DATABASE_URL="postgresql://amlak:amlak@localhost:5432/amlak"
PORT=3001
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Without a key, emails are printed to the console. Create one at resend.com/api-keys
# RESEND_API_KEY=""
# Until the domain is verified, Resend's test sender only delivers to your own Resend email
# EMAIL_FROM="Amlak <noreply@mail.your-domain>"
# EMAIL_FROM="Amlak <noreply@mail.amlak.software>"
# Where the web app runs; invitation links in emails point here
# APP_URL="http://localhost:5173"

# Photo storage on AWS S3. Use the bucket's full name as S3 shows it
S3_BUCKET=""
S3_REGION="eu-central-1"
# Keys of the amlak-dev IAM user. Leave empty on EC2, which uses its IAM role
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# The first Admin, created by `bunx prisma db seed`. Delete the password from
# this file once the Admin exists; running the seed again does not change it
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_PHONE=+966500000000
# ADMIN_NAME=Amlak Admin