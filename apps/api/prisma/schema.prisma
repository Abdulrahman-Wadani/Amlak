generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Language {
    ar
    en
}

enum UserStatus {
    INVITED
    PENDING_VERIFICATION
    ACTIVE
    DEACTIVATED
}

enum TokenType {
    EMAIL_OTP
    PASSWORD_RESET
    ACCOUNT_SETUP
}

enum PlaceStatus {
    ACTIVE
    INACTIVE
    UNDER_MAINTENANCE
}

enum AssetStatus {
    GOOD
    NEEDS_MAINTENANCE
    UNDER_MAINTENANCE
    OUT_OF_SERVICE
}

enum IntervalUnit {
    DAY
    WEEK
    MONTH
    YEAR
}

enum TicketType {
    CORRECTIVE
    PREVENTIVE
}

enum TicketPriority {
    LOW
    MEDIUM
    HIGH
    URGENT
}

enum TicketStatus {
    PENDING_REVIEW
    APPROVED
    REJECTED
    COMPLETED
}

enum AttachmentType {
    DAMAGE
    AFTER_REPAIR
}

enum BookingStatus {
    CONFIRMED
    CHECKED_IN
    CHECKED_OUT
    CANCELLED
}

enum ExpenseCategory {
    MAINTENANCE
    UTILITIES
    TAXES
    CLEANING
    SUPPLIES
    OTHER
}

enum NotificationType {
    TICKET_SUBMITTED
    TICKET_ASSIGNED
    TICKET_REJECTED
    TICKET_COMPLETED
    MAINTENANCE_REMINDER
    MAINTENANCE_OVERDUE
    SUPPORT_RESOLVED
    ANNOUNCEMENT
}

enum SupportTicketStatus {
    OPEN
    RESOLVED
}

model Role {
    id          String   @id @default(uuid()) @db.Uuid
    name        String   @unique
    description String?
    created_at  DateTime @default(now()) @db.Timestamptz(3)
    updated_at  DateTime @updatedAt @db.Timestamptz(3)

    users User[]

    @@map("roles")
}

model User {
    id                 String     @id @default(uuid()) @db.Uuid
    role_id            String     @db.Uuid
    email              String     @unique
    password_hash      String?
    phone              String
    fullname           String
    picture_path       String?
    status             UserStatus
    email_verified_at  DateTime?  @db.Timestamptz(3)
    preferred_language Language   @default(ar)
    manager_id         String?    @db.Uuid
    created_at         DateTime   @default(now()) @db.Timestamptz(3)
    updated_at         DateTime   @updatedAt @db.Timestamptz(3)

    role    Role   @relation(fields: [role_id], references: [id])
    manager User?  @relation("ManagerWorkers", fields: [manager_id], references: [id], onDelete: Restrict)
    workers User[] @relation("ManagerWorkers")

    verification_tokens VerificationToken[]
    refresh_tokens      RefreshToken[]

    owned_places      Place[]
    place_assignments PlaceWorker[] @relation("AssignedWorker")
    assignments_made  PlaceWorker[] @relation("AssignedBy")

    default_schedules PeriodicMaintenance[]

    reported_tickets     MaintenanceTicket[] @relation("TicketReporter")
    assigned_tickets     MaintenanceTicket[] @relation("TicketAssignee")
    reviewed_tickets     MaintenanceTicket[] @relation("TicketReviewer")
    uploaded_attachments TicketAttachment[]

    created_bookings     Booking[] @relation("BookingCreator")
    cancelled_bookings   Booking[] @relation("BookingCanceller")
    checked_in_bookings  Booking[] @relation("BookingCheckIn")
    checked_out_bookings Booking[] @relation("BookingCheckOut")
    logged_expenses      Expense[]

    notifications            Notification[]  @relation("NotificationRecipient")
    sent_notifications       Notification[]  @relation("NotificationSender")
    support_tickets          SupportTicket[] @relation("SupportSubmitter")
    resolved_support_tickets SupportTicket[] @relation("SupportResolver")
    web_contents             WebContent[]
    audit_logs               AuditLog[]

    @@map("users")
}

model VerificationToken {
    id         String    @id @default(uuid()) @db.Uuid
    user_id    String    @db.Uuid
    token_hash String
    token_type TokenType
    expires_at DateTime  @db.Timestamptz(3)
    attempts   Int       @default(0)
    is_used    Boolean   @default(false)
    created_at DateTime  @default(now()) @db.Timestamptz(3)
    updated_at DateTime  @updatedAt @db.Timestamptz(3)

    user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@map("verification_tokens")
}

model RefreshToken {
    id          String    @id @default(uuid()) @db.Uuid
    user_id     String    @db.Uuid
    token_hash  String    @unique
    device_info String?
    expires_at  DateTime  @db.Timestamptz(3)
    revoked_at  DateTime? @db.Timestamptz(3)
    created_at  DateTime  @default(now()) @db.Timestamptz(3)
    updated_at  DateTime  @updatedAt @db.Timestamptz(3)

    user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@map("refresh_tokens")
}

model Place {
    id                         String      @id @default(uuid()) @db.Uuid
    owner_id                   String      @db.Uuid
    place_name                 String
    place_type                 String
    description                String?
    address                    String?
    city                       String
    latitude                   Decimal?    @db.Decimal(9, 6)
    longitude                  Decimal?    @db.Decimal(9, 6)
    status                     PlaceStatus @default(ACTIVE)
    monthly_maintenance_budget Decimal?    @db.Decimal(12, 2)
    currency                   String      @default("SAR")
    timezone                   String      @default("Asia/Riyadh")
    deleted_at                 DateTime?   @db.Timestamptz(3)
    created_at                 DateTime    @default(now()) @db.Timestamptz(3)
    updated_at                 DateTime    @updatedAt @db.Timestamptz(3)

    owner         User          @relation(fields: [owner_id], references: [id])
    place_workers PlaceWorker[]

    assets Asset[]

    tickets MaintenanceTicket[]

    bookings Booking[]
    expenses Expense[]

    @@map("places")
}

model PlaceWorker {
    id          String   @id @default(uuid()) @db.Uuid
    place_id    String   @db.Uuid
    worker_id   String   @db.Uuid
    assigned_by String   @db.Uuid
    is_active   Boolean  @default(true)
    assigned_at DateTime @default(now()) @db.Timestamptz(3)
    created_at  DateTime @default(now()) @db.Timestamptz(3)
    updated_at  DateTime @updatedAt @db.Timestamptz(3)

    place    Place @relation(fields: [place_id], references: [id])
    worker   User  @relation("AssignedWorker", fields: [worker_id], references: [id])
    assigner User  @relation("AssignedBy", fields: [assigned_by], references: [id])

    @@unique([place_id, worker_id])
    @@map("place_workers")
}

model Asset {
    id            String      @id @default(uuid()) @db.Uuid
    place_id      String      @db.Uuid
    name          String
    type          String
    status        AssetStatus @default(GOOD)
    purchase_date DateTime?   @db.Date
    deleted_at    DateTime?   @db.Timestamptz(3)
    created_at    DateTime    @default(now()) @db.Timestamptz(3)
    updated_at    DateTime    @updatedAt @db.Timestamptz(3)

    place     Place                 @relation(fields: [place_id], references: [id])
    schedules PeriodicMaintenance[]

    tickets MaintenanceTicket[]

    @@map("assets")
}

model PeriodicMaintenance {
    id                  String       @id @default(uuid()) @db.Uuid
    asset_id            String       @db.Uuid
    default_assignee_id String?      @db.Uuid
    description         String
    interval_count      Int
    interval_unit       IntervalUnit
    next_due_date       DateTime     @db.Date
    lead_days           Int          @default(7)
    is_active           Boolean      @default(true)
    created_at          DateTime     @default(now()) @db.Timestamptz(3)
    updated_at          DateTime     @updatedAt @db.Timestamptz(3)

    asset            Asset @relation(fields: [asset_id], references: [id])
    default_assignee User? @relation(fields: [default_assignee_id], references: [id])

    tickets MaintenanceTicket[]

    @@map("periodic_maintenances")
}

model MaintenanceTicket {
    id                      String         @id @default(uuid()) @db.Uuid
    place_id                String         @db.Uuid
    asset_id                String?        @db.Uuid
    periodic_maintenance_id String?        @db.Uuid
    reporter_id             String?        @db.Uuid
    assignee_id             String?        @db.Uuid
    reviewed_by             String?        @db.Uuid
    ticket_type             TicketType
    priority                TicketPriority
    description             String
    estimated_cost          Decimal?       @db.Decimal(12, 2)
    actual_cost             Decimal?       @db.Decimal(12, 2)
    status                  TicketStatus   @default(PENDING_REVIEW)
    due_date                DateTime?      @db.Date
    reviewed_at             DateTime?      @db.Timestamptz(3)
    rejection_reason        String?
    completed_at            DateTime?      @db.Timestamptz(3)
    completion_notes        String?
    reminder_sent_at        DateTime?      @db.Timestamptz(3)
    overdue_alert_sent_at   DateTime?      @db.Timestamptz(3)
    created_at              DateTime       @default(now()) @db.Timestamptz(3)
    updated_at              DateTime       @updatedAt @db.Timestamptz(3)

    place       Place                @relation(fields: [place_id], references: [id])
    asset       Asset?               @relation(fields: [asset_id], references: [id])
    schedule    PeriodicMaintenance? @relation(fields: [periodic_maintenance_id], references: [id])
    reporter    User?                @relation("TicketReporter", fields: [reporter_id], references: [id], onDelete: Restrict)
    assignee    User?                @relation("TicketAssignee", fields: [assignee_id], references: [id], onDelete: Restrict)
    reviewer    User?                @relation("TicketReviewer", fields: [reviewed_by], references: [id], onDelete: Restrict)
    attachments TicketAttachment[]

    expenses Expense[]

    @@map("maintenance_tickets")
}

model TicketAttachment {
    id              String         @id @default(uuid()) @db.Uuid
    ticket_id       String         @db.Uuid
    uploaded_by     String         @db.Uuid
    file_url        String
    attachment_type AttachmentType
    created_at      DateTime       @default(now()) @db.Timestamptz(3)
    updated_at      DateTime       @updatedAt @db.Timestamptz(3)

    ticket   MaintenanceTicket @relation(fields: [ticket_id], references: [id])
    uploader User              @relation(fields: [uploaded_by], references: [id])

    @@map("ticket_attachments")
}

model Booking {
    id                  String        @id @default(uuid()) @db.Uuid
    place_id            String        @db.Uuid
    created_by          String        @db.Uuid
    guest_name          String
    guest_phone         String
    guest_email         String?
    guest_count         Int
    check_in_date       DateTime      @db.Date
    check_out_date      DateTime      @db.Date
    total_price         Decimal       @db.Decimal(12, 2)
    status              BookingStatus @default(CONFIRMED)
    notes               String?
    cancelled_at        DateTime?     @db.Timestamptz(3)
    cancelled_by        String?       @db.Uuid
    cancellation_reason String?
    checked_in_at       DateTime?     @db.Timestamptz(3)
    checked_in_by       String?       @db.Uuid
    checked_out_at      DateTime?     @db.Timestamptz(3)
    checked_out_by      String?       @db.Uuid
    created_at          DateTime      @default(now()) @db.Timestamptz(3)
    updated_at          DateTime      @updatedAt @db.Timestamptz(3)

    place       Place @relation(fields: [place_id], references: [id])
    creator     User  @relation("BookingCreator", fields: [created_by], references: [id])
    canceller   User? @relation("BookingCanceller", fields: [cancelled_by], references: [id], onDelete: Restrict)
    checked_in  User? @relation("BookingCheckIn", fields: [checked_in_by], references: [id], onDelete: Restrict)
    checked_out User? @relation("BookingCheckOut", fields: [checked_out_by], references: [id], onDelete: Restrict)

    @@map("bookings")
}

model Expense {
    id           String          @id @default(uuid()) @db.Uuid
    place_id     String          @db.Uuid
    ticket_id    String?         @db.Uuid
    created_by   String          @db.Uuid
    category     ExpenseCategory
    description  String?
    amount       Decimal         @db.Decimal(12, 2)
    expense_date DateTime        @db.Date
    receipt_url  String?
    created_at   DateTime        @default(now()) @db.Timestamptz(3)
    updated_at   DateTime        @updatedAt @db.Timestamptz(3)

    place   Place              @relation(fields: [place_id], references: [id])
    ticket  MaintenanceTicket? @relation(fields: [ticket_id], references: [id])
    creator User               @relation(fields: [created_by], references: [id])

    @@map("expenses")
}

model Notification {
    id         String           @id @default(uuid()) @db.Uuid
    user_id    String           @db.Uuid
    sender_id  String?          @db.Uuid
    type       NotificationType
    title      String
    message    String
    is_read    Boolean          @default(false)
    created_at DateTime         @default(now()) @db.Timestamptz(3)
    updated_at DateTime         @updatedAt @db.Timestamptz(3)

    recipient User  @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade)
    sender    User? @relation("NotificationSender", fields: [sender_id], references: [id])

    @@map("notifications")
}

model SupportTicket {
    id             String              @id @default(uuid()) @db.Uuid
    user_id        String              @db.Uuid
    resolved_by    String?             @db.Uuid
    subject        String
    description    String
    status         SupportTicketStatus @default(OPEN)
    admin_response String?
    resolved_at    DateTime?           @db.Timestamptz(3)
    created_at     DateTime            @default(now()) @db.Timestamptz(3)
    updated_at     DateTime            @updatedAt @db.Timestamptz(3)

    submitter User  @relation("SupportSubmitter", fields: [user_id], references: [id])
    resolver  User? @relation("SupportResolver", fields: [resolved_by], references: [id], onDelete: Restrict)

    @@map("support_tickets")
}

model WebContent {
    id           String   @id @default(uuid()) @db.Uuid
    author_id    String   @db.Uuid
    title        String
    language     Language
    slug         String
    body         String
    is_published Boolean  @default(false)
    created_at   DateTime @default(now()) @db.Timestamptz(3)
    updated_at   DateTime @updatedAt @db.Timestamptz(3)

    author User @relation(fields: [author_id], references: [id])

    @@unique([language, slug])
    @@map("web_contents")
}

model AuditLog {
    id          String   @id @default(uuid()) @db.Uuid
    user_id     String   @db.Uuid
    action      String
    entity_type String
    entity_id   String   @db.Uuid
    old_values  Json?
    new_values  Json?
    ip_address  String?
    created_at  DateTime @default(now()) @db.Timestamptz(3)

    user User @relation(fields: [user_id], references: [id])

    @@map("audit_logs")
}
