{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["bun"]
	},
	"include": ["src", "scripts", "prisma.config.ts"]
}
